{
  "name": "@near-intents-agent-api/sdk",
  "version": "0.3.0",
  "description": "Typed server-side HTTP client for the NEAR Intents Agent API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEAR-Intents-Agent-API/sdk-typescript.git"
  },
  "homepage": "https://github.com/NEAR-Intents-Agent-API/sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/NEAR-Intents-Agent-API/sdk-typescript/issues"
  },
  "keywords": [
    "near",
    "near-intents",
    "agents",
    "sdk",
    "1click"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm typecheck && tsdown && node -e \"import('./dist/index.mjs')\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check": "pnpm lint && pnpm build && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^24.12.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
